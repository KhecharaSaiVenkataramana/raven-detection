# Copy this file to .env and fill in real values. Never commit .env.

# Signs JWT auth tokens — use a long random string in production.
# (openssl rand -hex 32)
JWT_SECRET_KEY=

# Defaults to a local SQLite file if unset. Set to a MySQL/Postgres URL in production,
# e.g. mysql+pymysql://user:password@host:3306/dbname
DATABASE_URL=

# The Next.js frontend's origin, for CORS.
FRONTEND_ORIGIN=http://localhost:3000

# Optional — only needed for the /contact suggestion-email feature.
SMTP_USER=
SMTP_PASSWORD=
TEAM_EMAIL=

# Optional — override where the .pt model files live. Defaults to ../website/models
MODELS_DIR=
